# Paste into the .env editor of the highleads Dockge stack.
# Set your own password of at least 16 characters. Do not commit the real .env.
HIGHLEADS_PASSWORD=
# Optional until connecting searches:
APIFY_TOKEN=
# Optional: set the NAS LAN IP to narrow the published interface.
HIGHLEADS_BIND_IP=0.0.0.0
